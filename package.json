{
  "name": "fleet-pulse-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.2"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace @fleet-pulse/frontend",
    "build": "npm run build --workspace @fleet-pulse/frontend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
